# Copy this file to .env and fill in your own values, or just run
# `python3 authorize.py` and it will create this file for you automatically.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: show extra disk usage bars beyond "/". Format is path:label,
# comma-separated. Label is trimmed to 5 characters for display.
# NOWPLAYING_EXTRA_DISKS=/mnt/photos:PICS,/mnt/media:MEDIA
